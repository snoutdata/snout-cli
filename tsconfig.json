{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": false,
		"sourceMap": false,
		"outDir": "out",
		"rootDir": "src",
		"types": ["node"],
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/**/*.ts"]
}
