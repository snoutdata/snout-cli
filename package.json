{
	"name": "snoutdata",
	"version": "0.7.0",
	"description": "SnoutData Cloud projects from a terminal or an agent. Create a project with a Postgres database, get a DATABASE_URL, run migrations, and serve the same operations to an AI agent over MCP.",
	"license": "Apache-2.0",
	"author": "SnoutData",
	"homepage": "https://snoutdata.com",
	"bugs": {
		"url": "https://snoutdata.com/contact"
	},
	"keywords": [
		"postgres",
		"postgresql",
		"database",
		"hosted-database",
		"serverless-postgres",
		"cli",
		"mcp",
		"model-context-protocol",
		"agent",
		"ai-agent",
		"migrations",
		"devops",
		"snoutdata"
	],
	"type": "module",
	"bin": {
		"snoutdata": "dist/snoutdata.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "node ../cloud/sync-engine.mjs cli cliControl && tsc -p tsconfig.json && node build.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "tsc -p tsconfig.json && node --test \"out/**/*.test.js\"",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"esbuild": "^0.24.0",
		"typescript": "^5.6.0"
	}
}
